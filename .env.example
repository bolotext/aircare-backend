# --- App / server ---
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- MongoDB (shared by users + reports + scheduler) ---
MONGO_URI=
MONGO_DB_NAME=aircare

# --- Auth (JWT, internal key, rate limit, bootstrap admin) ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
INTERNAL_API_KEY=
INTROSPECT_TIMEOUT_SECONDS=5.0
LOGIN_RATE_LIMIT=5/minute
BOOTSTRAP_ADMIN_EMAIL=narendra.singh@gnani.ai
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

# --- Reports: pagination, mailer, audio, prod import ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
ALERT_API_URL=http://172.16.10.9:8080/alert
ALERT_API_TIMEOUT_SECONDS=10.0
AUDIO_SERVER_URL=http://172.16.10.9:11515/audioserver/getaudio
AUDIO_SERVER_TIMEOUT_SECONDS=15.0
PROD_IMPORT_BASE_URL=https://botfwbackend.gnani.site
REPORT_SCOPES=all
REPORT_SEND_HOUR_IST=6
SCHEDULER_POLL_SECONDS=300

