LOG_LEVEL=INFO

# Upstream microservices
USERS_SERVICE_URL=http://localhost:8001
REPORTS_SERVICE_URL=http://localhost:8002
MCP_CLIENTS_SERVICE_URL=http://localhost:8003

UPSTREAM_TIMEOUT_SECONDS=30

# Comma-separated browser origins allowed to call this gateway (the only
# service a browser talks to directly). Add your deployed frontend's origin
# in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
