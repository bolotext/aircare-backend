# App
LOG_LEVEL=INFO

# --- MongoDB MCP server (mongodb-js/mongodb-mcp-server) ---
# Full connection string to YOUR assignment Mongo instance (local mongod, Atlas free tier, etc).
# The app spawns the MCP server itself and hands it this string — nothing else needs to run it manually.
MDB_MCP_CONNECTION_STRING=mongodb://localhost:27017/aircare
MDB_MCP_DB_NAME=aircare
# mongodb-mcp-server is installed globally (pinned) at image build time —
# see services/mcp_clients/Dockerfile. Leave these two unless you've installed
# it differently (e.g. locally via `npm install -g mongodb-mcp-server` for
# running this service outside Docker):
MDB_MCP_SERVER_COMMAND=mongodb-mcp-server
MDB_MCP_SERVER_ARGS=

# --- Redis MCP server (redis/mcp-redis) ---
# Connection URL to YOUR local/dev Redis instance used as the atomic slot store.
REDIS_MCP_URL=redis://localhost:6379/0
# Leave these two unless your uvx/redis-mcp-server invocation differs:
REDIS_MCP_SERVER_COMMAND=uvx
REDIS_MCP_SERVER_ARGS=--from redis-mcp-server redis-mcp-server

# Bounded per-call timeout for every Mongo/Redis MCP tool call, seconds.
MCP_CALL_TIMEOUT_SECONDS=3
# TTL on the reserve_slot idempotency marker (slot_reservation:<call_id>), seconds.
AIRCARE_SLOT_TTL_SECONDS=900
