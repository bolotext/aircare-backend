# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=aircare

# Identity is resolved via the Users service's internal introspection
# endpoint rather than decoding JWTs locally.
USERS_SERVICE_URL=http://localhost:45462
# Must be identical to the Users service's own INTERNAL_API_KEY.
INTERNAL_API_KEY=replace-with-a-long-random-secret
INTROSPECT_TIMEOUT_SECONDS=5.0

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Automailer — internal mail-relay HTTP API. Without it, report runs are
# marked "failed" (see mailer/send_mail.py).
ALERT_API_URL=http://172.16.10.9:8080/alert
ALERT_API_TIMEOUT_SECONDS=10.0

# Internal audio server GET /calls/{conversation_id}/recording proxies to
# (see calls/recording.py). Private-network-only, no auth of its own.
AUDIO_SERVER_URL=http://172.16.10.9:11515/audioserver/getaudio
AUDIO_SERVER_TIMEOUT_SECONDS=15.0

# Daily send time, Asia/Kolkata hour-of-day (0-23).
REPORT_SEND_HOUR_IST=6
# How often the scheduler loop wakes up to check whether it's time to send.
SCHEDULER_POLL_SECONDS=300
# Documented simplification (see mailer/scheduler.py): the scheduler cannot
# discover "every project" from the Users service (no internal listing
# endpoint for that), so the scopes it emails daily are config-driven.
# Comma-separated project ids, and/or the literal "all" for a combined report.
REPORT_SCOPES=all
