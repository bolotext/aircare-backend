# App
LOG_LEVEL=INFO

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=aircare

# Sweep cadence / decision thresholds
AQI_POLL_INTERVAL_MINUTES=30
AQI_FRESHNESS_WINDOW_MINUTES=60
AQI_TOLERANCE=20
CALLBACK_COOLDOWN_HOURS=24
AQI_PATIENT_FETCH_LIMIT=1000

# AQI sources — without these, every city comes back "inconclusive" and no
# advisory calls are ever initiated (see fetch_openaq_reading/fetch_waqi_reading).
# https://explore.openaq.org (free API key)
OPENAQ_API_KEY=
# https://aqicn.org/data-platform/token (free token)
WAQI_API_TOKEN=

# Inya Platform outbound telephony — without these, calls are logged/queued
# but never actually placed (see trigger_inya_outbound_call).
INYA_API_BASE_URL=https://api.inya.ai/platform/v1
INYA_BOT_ID=
INYA_API_KEY=
# Omitted from the request when unset.
INYA_CALL_ENVIRONMENT=

# Internal mail-relay HTTP API (ops alert emails) — without it, mailer.send_mail
# logs a warning and no-ops instead of sending.
ALERT_API_URL=http://172.16.10.9:8080/alert
# Comma-separated. Falls back to a hardcoded default distribution list if unset.
ALERT_EMAIL_OPS=
